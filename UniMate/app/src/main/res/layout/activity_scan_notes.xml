<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_unomate_ai"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="34dp"
        android:paddingEnd="24dp"
        android:paddingBottom="34dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:text="← Back"
            android:textColor="#4F46E5"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="OCR Note Scanner"
            android:textColor="#020617"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Camera based scanner for printed or handwritten notes."
            android:textColor="#111827"
            android:textSize="17sp"
            android:textStyle="bold"
            android:lineSpacingExtra="6dp" />

        <!-- Scanner Frame -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="420dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/scanner_panel"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="22dp">

            <ImageView
                android:id="@+id/imagePreview"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtCameraIcon"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:gravity="center"
                android:text="📷"
                android:textSize="54sp" />

            <TextView
                android:id="@+id/txtScanStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="No photo selected yet"
                android:textColor="#64748B"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/btnTakePicture"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/btn_primary"
                android:gravity="center"
                android:text="Take Picture"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- How to use -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/scanner_panel"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="How to use?"
                android:textColor="#020617"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="1. Tap Take Picture\nStart from the AI Learning Assistant page by pressing Scan Material.\n\n2. Place note in the frame\nMake sure the text is clear and not covered by shadows.\n\n3. Save for AI processing\nLater, this photo can be sent to OCR or AI summary."
                android:textColor="#111827"
                android:textSize="16sp"
                android:lineSpacingExtra="7dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>