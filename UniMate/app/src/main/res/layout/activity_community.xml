<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9FAFB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="UNIMATE"
            android:textColor="#6366F1"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.35" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Student Community Center"
            android:textColor="#111827"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Support student wellbeing, social connection, and campus participation."
            android:textColor="#64748B"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp" />

        <!-- Mood Check Card -->
        <LinearLayout
            android:id="@+id/cardMoodCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_mood_gradient"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginTop="24dp"
            android:elevation="6dp"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WELLBEING CHECK"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.2" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="How are you today?"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp"/>

            <!-- Selected Mood Emoji -->
            <TextView
                android:id="@+id/txtMoodEmoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="😀"
                android:textSize="36sp"
                android:layout_marginTop="8dp"/>

            <!-- Emoji Row -->
            <LinearLayout
                android:id="@+id/moodEmojiRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="12dp"
                android:weightSum="4">

                <!-- Emoji buttons -->
                <LinearLayout
                    android:id="@+id/emojiGreat"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/card_emoji_mod"
                    android:elevation="4dp"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="😀"
                        android:textSize="28sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Great"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/emojiGood"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/card_emoji_mod"
                    android:elevation="4dp"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="😊"
                        android:textSize="28sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Good"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/emojiOkay"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/card_emoji_mod"
                    android:elevation="4dp"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="😐"
                        android:textSize="28sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Okay"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/emojiStressed"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/card_emoji_mod"
                    android:elevation="4dp"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="😟"
                        android:textSize="28sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Stressed"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/btnStartStressCheck"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="Start stress self-check"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_white_round"
                android:textStyle="bold"
                android:textSize="16sp"/>
        </LinearLayout>

        <!-- AI Chat Section -->
        <LinearLayout
            android:id="@+id/cardAIChat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:background="@drawable/card_white_big"
            android:padding="20dp"
            android:elevation="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ask AI"
                android:textColor="#111827"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/inputAIQuestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Type your question..."
                android:padding="12dp"
                android:background="@drawable/search_box"
                android:textColor="#111827"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/btnSendAI"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Send"
                    android:background="@drawable/btn_primary"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"/>

                <Button
                    android:id="@+id/btnSpeakAI"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="🎤"
                    android:textSize="24sp"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/txtAIResponse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="AI response will appear here..."
                android:textColor="#111827"
                android:textSize="16sp"/>
        </LinearLayout>

        <!-- Weekly Mood Report -->
        <LinearLayout
            android:id="@+id/cardMoodReport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:background="@drawable/card_white_big"
            android:padding="20dp"
            android:elevation="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Weekly Mood Report"
                android:textColor="#111827"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/txtMoodReport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Last week's mood: Good"
                android:textColor="#64748B"
                android:textSize="16sp"/>
        </LinearLayout>

        <!-- Bottom Navigation -->
        <LinearLayout
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="86dp"
            android:layout_marginTop="24dp"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bottom_nav_white"
            android:elevation="10dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="🏠\nHome"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/navAcademic"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="📅\nAcademic"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/navAiLearning"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="🤖\nAI Study"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/navCommunity"
                android:layout_width="86dp"
                android:layout_height="64dp"
                android:background="@drawable/nav_selected"
                android:gravity="center"
                android:text="💗\nCommunity"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>