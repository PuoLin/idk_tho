<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/btnModifyAssignBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="⬅ Back to Manage"
                android:textColor="#6B7280"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Modify Assignment"
                android:textColor="#111827"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:text="Upload rubrics and set deadlines."
                android:textColor="#6B7280"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ASSIGNMENT TITLE"
                android:textColor="#111827"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etModifyAssignTitle"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:background="#FFFFFF"
                android:elevation="2dp"
                android:hint="e.g., HCI Prototype Screens"
                android:paddingHorizontal="16dp"
                android:textColor="#111827"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DUE DATE &amp; TIME"
                android:textColor="#111827"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etModifyAssignDueDate"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:background="#FFFFFF"
                android:elevation="2dp"
                android:hint="e.g., Friday, 11:59 PM"
                android:paddingHorizontal="16dp"
                android:textColor="#111827"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ATTACHMENTS"
                android:textColor="#111827"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:background="#FFFFFF"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <Button
                    android:id="@+id/btnModifyAssignUpload"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:backgroundTint="#E0E7FF"
                    android:text="📎 Attach File"
                    android:textColor="#4F46E5"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvModifyAssignFileName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="No file selected"
                    android:textColor="#6B7280"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end"/>
            </LinearLayout>

            <Switch
                android:id="@+id/switchModifyAssignHidden"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:text="Save as Draft (Hidden from students)"
                android:textColor="#111827"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:ignore="UseSwitchCompatOrMaterialXml" />

            <Button
                android:id="@+id/btnModifyAssignSave"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="80dp"
                android:backgroundTint="#3B82F6"
                android:text="Save Changes"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>