<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_unomate_ai"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="34dp"
        android:paddingEnd="24dp"
        android:paddingBottom="34dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:text="← Back"
            android:textColor="#4F46E5"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Material Preview"
            android:textColor="#020617"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Choose what should AI do with scanned or uploaded learning material."
            android:textColor="#111827"
            android:textSize="17sp" />

        <!-- Extracted Text Preview -->
        <LinearLayout
            android:id="@+id/cardTextPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_white_big"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:id="@+id/txtExtractedPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Extracted text will appear here..."
                android:textColor="#111827"
                android:textSize="16sp"
                android:lineSpacingExtra="6dp" />

        </LinearLayout>

        <!-- AI Actions -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="AI Actions"
            android:textColor="#111827"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:weightSum="2">

            <TextView
                android:id="@+id/btnSummarize"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="80dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/card_blue"
                android:gravity="center"
                android:text="Summarize\nCreate key points"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:padding="10dp" />

            <TextView
                android:id="@+id/btnTranslate"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="80dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/card_cyan"
                android:gravity="center"
                android:text="Translate\nChange the language"
                android:textColor="#111827"
                android:textSize="16sp"
                android:textStyle="bold"
                android:padding="10dp" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>